{
  email {$ACME_EMAIL}
}
{$PUBLIC_HOST} {
  encode zstd gzip
  @private path /internal/*
  respond @private 404
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  reverse_proxy app:3100 {
    transport http {
      dial_timeout 5s
    }
  }
}
